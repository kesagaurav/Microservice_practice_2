package com.gaurav.service.impl;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.cloud.client.ServiceInstance;
import org.springframework.cloud.client.discovery.DiscoveryClient;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import com.gaurav.dto.CompanyDTO;
import com.gaurav.dto.EmployeeDTO;
import com.gaurav.exception.EmployeeException;
import com.gaurav.model.Employee;
import com.gaurav.repository.EmployeeRepository;
import com.gaurav.service.EmployeeService;
@Service
public class EmployeeServiceImpl implements EmployeeService {
	@Autowired
	private EmployeeRepository erepo;
	@Autowired
	RestTemplate rt;
	@Autowired
	DiscoveryClient dc;
	
	String companyUri;
	
	@Override
	public EmployeeDTO createEmployee(EmployeeDTO edto) {
		// TODO Auto-generated method stub
		Employee entity = edto.createEntity();
	    Employee savedEmployee = erepo.save(entity);

	    EmployeeDTO responseDTO = EmployeeDTO.entityToDTO(savedEmployee);

	    return responseDTO;
	}

	@Override
	public List<EmployeeDTO> getAllEmployees() {
		// TODO Auto-generated method stub
		return erepo.findAll().stream().map(a->EmployeeDTO.entityToDTO(a)).collect(Collectors.toList());
	}

	@Override
	public EmployeeDTO getById(int eid) throws EmployeeException {
		// TODO Auto-generated method stub
		Employee orElseThrow = erepo.findById(eid).orElseThrow(()->new EmployeeException("id is not found " + eid));
		List<ServiceInstance> instances = dc.getInstances("CompanyMicroservice");
		if(instances!=null&&!instances.isEmpty()) 
			companyUri = instances.get(0).getUri().toString();
		
		//using rest template
//		CompanyDTO forObject = rt.getForObject(
//			    "http://localhost:9091/company/" + orElseThrow.getCid(),
//			    CompanyDTO.class
//			);
		//using service discovery
		CompanyDTO forObject = rt.getForObject(
			    companyUri + "/company/" + orElseThrow.getCid(),
			    CompanyDTO.class
			);
		ServiceInstance instance = instances.get(0);

		System.out.println("Host: " + instance.getHost());
		System.out.println("Port: " + instance.getPort());
		System.out.println("URI: " + instance.getUri());


		EmployeeDTO entityToDTO = EmployeeDTO.entityToDTO(orElseThrow);

		
		entityToDTO.setCdto(forObject);
	
		return entityToDTO;
	}

	@Override
	public EmployeeDTO updateEmployee(EmployeeDTO edto, int eid) throws EmployeeException {
		// TODO Auto-generated method stub
		Employee orElseThrow = erepo.findById(eid).orElseThrow(()->new EmployeeException("id is not found " + eid));
		orElseThrow.setName(edto.getName());
		orElseThrow.setDept(edto.getName());
		orElseThrow.setSal(edto.getSal());
		Employee save = erepo.save(orElseThrow);
		return EmployeeDTO.entityToDTO(save);
	}

	@Override
	public EmployeeDTO delete(int eid) throws EmployeeException {
		// TODO Auto-generated method stub
		 Employee e = erepo.findById(eid).orElseThrow(()->new EmployeeException("id is not found " + eid));
		erepo.delete(e);
		 return EmployeeDTO.entityToDTO(e);
	}

}
